# Rate limiting, adapted from usegalaxy.org's conf.d/rate_limit.conf
# (galaxyproject/infrastructure-playbook). The limits themselves are applied
# in templates/nginx/galaxy-main.j2.
#
# Requests are keyed on (in order of precedence):
#   1. the X-API-Key header, if present
#   2. the galaxysession cookie
#   3. the client IP
# so that many users behind one NAT (a classroom or an institute) each get
# their own bucket, and one heavy user cannot use up everyone's allowance.
#
# The key is blanked (and the request therefore not limited at all) for
# exempt paths and exempt networks, see the maps below.

# Traefik terminates TLS in front of this nginx, so without real_ip every
# request would share a single bucket keyed on Traefik's address. Only list
# proxies here, otherwise clients can spoof their own rate limit key.
{% for ip in nginx_rate_limit_real_ip_from | default([]) %}
set_real_ip_from {{ ip }};
{% endfor %}
real_ip_header   X-Forwarded-For;
real_ip_recursive on;

# 1. The API key, when sent in the X-API-Key header (as BioBlend and the
#    client do). Requests using ?key= fall through to the cookie or IP.
map $http_x_api_key $rate_limit_key_api {
    default $http_x_api_key;
    ''      '';
}

# 2. Otherwise the galaxysession cookie.
map $rate_limit_key_api $rate_limit_key_api_or_session {
    default $rate_limit_key_api;
    ''      $cookie_galaxysession;
}

# 3. Otherwise the client IP.
map $rate_limit_key_api_or_session $rate_limit_key_keyed {
    default $rate_limit_key_api_or_session;
    ''      $binary_remote_addr;
}

# Paths that carry bulk data transfers and must not be limited. EU uses the
# nginx upload module, so the _-prefixed paths and their rewrite targets are
# exempt in addition to the tusd endpoint.
map $request_uri $rate_limit_path_exempt {
    default                        '';
    ~^/api/upload/resumable_upload 'exempt';
    ~^/api/job_files               'exempt';
    ~^/_job_files                  'exempt';
    ~^/api/jobs/[^/]+/files        'exempt';
    ~^/_upload                     'exempt';
}

# Networks that are never rate limited (internal, monitoring, pulsar relay).
geo $rate_limit_network_exempt {
    default 0;
{% for network in nginx_rate_limit_exempt_networks | default([]) %}
    {{ network }} 1;
{% endfor %}
}

# Blank the key for exempt paths and/or exempt networks. The lookup string is
# the path exemption concatenated with the network flag: '', '0', '1',
# 'exempt0' or 'exempt1'.
map $rate_limit_path_exempt$rate_limit_network_exempt $rate_limit_key {
    default   $rate_limit_key_keyed;
    '1'       '';
    'exempt0' '';
    'exempt1' '';
}

# All matching crawlers share a single bucket, so a misbehaving bot cannot
# get a fresh allowance by rotating API keys, cookies or IPs. Keep the list
# in sync with files/galaxy/config/robots.txt.
map $http_user_agent $rate_limit_crawler {
    default '';
    '~*{{ nginx_crawler_user_agents }}' 'crawler';
}

# An empty key means the request is not counted in that zone, so the relaxed
# and strict zones only apply to regular clients and the crawler zone only
# applies to matching user agents.
limit_req_zone $rate_limit_key zone=relaxed:10m rate={{ nginx_rate_limit_relaxed_rate | default('8r/s') }};
limit_req_zone $rate_limit_key zone=strict:10m rate={{ nginx_rate_limit_strict_rate | default('4r/s') }};
limit_req_zone $rate_limit_crawler zone=crawler:10m rate={{ nginx_rate_limit_crawler_rate | default('1r/s') }};

{% if nginx_rate_limit_dry_run | default(true) | bool %}
# Log excess requests without rejecting them (nginx >= 1.17.1), for tuning
# rate and burst against real traffic before enforcing.
limit_req_dry_run on;
{% endif %}
