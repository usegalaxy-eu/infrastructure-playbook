#
# Job runner plugin configuration
#
{% set pulsar_sites = [
    ('be01', 'galaxy_be01', rabbitmq_password_galaxy_be01),
    ('bsc01', 'galaxy_bsc01', rabbitmq_password_galaxy_bsc01),
    ('cyf01', 'galaxy_cyf01', rabbitmq_password_galaxy_cyf01),
    ('cz01', 'galaxy_cz01', rabbitmq_password_galaxy_cz01),
    ('egi01', 'galaxy_egi01', rabbitmq_password_galaxy_egi01),
    ('es01', 'galaxy_es01', rabbitmq_password_galaxy_es01),
    ('fi01', 'galaxy_fi01', rabbitmq_password_galaxy_fi01),
    ('fr01', 'galaxy_fr01', rabbitmq_password_galaxy_fr01),
    ('hcmr01', 'galaxy_hcmr01', rabbitmq_password_galaxy_hcmr01),
    ('it01', 'galaxy_it01', rabbitmq_password_galaxy_it01),
    ('it02', 'galaxy_it02', rabbitmq_password_galaxy_it02),
    ('it03', 'galaxy_it03', rabbitmq_password_galaxy_it03),
    ('no01', 'galaxy_no01', rabbitmq_password_galaxy_no01),
    ('pt01', 'galaxy_pt01', rabbitmq_password_galaxy_pt01),
    ('sk01', 'galaxy_sk01', rabbitmq_password_galaxy_sk01),
    ('tubitak01', 'galaxy_tubitak01', rabbitmq_password_galaxy_tubitak01),
    ('uca01', 'galaxy_uca01', rabbitmq_password_galaxy_uca01),
    ('ufz_eve01', 'galaxy_ufz_eve01', rabbitmq_password_galaxy_ufz_eve01),
    ('uk01', 'galaxy_uk01', rabbitmq_password_galaxy_uk01),
    ('eosc01', 'galaxy_eosc01', rabbitmq_password_galaxy_eosc01),
    ('mira_runner', 'galaxy_mira_pulsar', rabbitmq_password_galaxy_mira_pulsar),
] %}
{% set runner_ids = ['condor', 'htcondor', 'local', 'pulsar_embedded'] %}
runners:
  condor:
    load: galaxy.jobs.runners.condor:CondorJobRunner
  htcondor:
    load: galaxy.jobs.runners.htcondor:HTCondorJobRunner
  local:
    load: galaxy.jobs.runners.local:LocalJobRunner
    workers: 8
  pulsar_embedded:
    load: galaxy.jobs.runners.pulsar:PulsarEmbeddedJobRunner
    pulsar_config: "{{ galaxy_config_dir }}/pulsar_app.yml"
{% for site, username, password in pulsar_sites %}
{% set runner_id = 'pulsar_mira_runner' if site == 'mira_runner' else 'pulsar_eu_' ~ site %}
{% set _ = runner_ids.append(runner_id) %}
  {{ runner_id }}:
    load: galaxy.jobs.runners.pulsar:PulsarMQJobRunner
    amqp_url: "pyamqp://{{ username }}:{{ password }}@mq.galaxyproject.eu:5671//pulsar/{{ username }}?ssl=1"
    galaxy_url: "https://usegalaxy.eu"
{% if site not in ['cz01', 'ufz_eve01'] %}
    manager: production
{% endif %}
    amqp_acknowledge: true
    amqp_ack_republish_time: 300
    amqp_consumer_timeout: 2.0
    amqp_publish_retry: true
    amqp_publish_retry_max_retries: 60
{% endfor %}

#
# Job handler configuration
#
handling:
  assign:
    - db-skip-locked
  max_grab: 16
  ready_window_size: 32
{% if galaxy_systemd_handlers > 0 %}
  processes:
{% set default_handler_plugins = runner_ids | reject('equalto', 'condor') | sort %}
#
# Set handler tags
#
{% set special_handlers = {
    0: {'tags': ['tiaas'], 'plugins': ['htcondor']},
    7: {'tags': ['test'], 'plugins': ['htcondor']},
} %}
{% for n in range(galaxy_systemd_handlers) %}
{% set handler = special_handlers.get(n, {}) %}
    {{ galaxy_systemd_handler_prefix }}_{{ n }}:
{% if handler.tags is defined %}
      tags:
{% for tag in handler.tags %}
        - {{ tag }}
{% endfor %}
{% endif %}
      plugins:
{% for plugin in handler.plugins | default(default_handler_plugins) %}
        - {{ plugin }}
{% endfor %}
{% endfor %}
{% else %}
  processes:
    DUMMY_PLACEHOLDER_FOR_HANDLER:
{% endif %}

#
# Job execution configuration
#
execution:
  default: tpv_dispatcher
  environments:
    local:
      runner: local
    tpv_dispatcher:
      runner: dynamic
      type: python
      function: map_tool_to_destination
      rules_module: tpv.rules
      tpv_config_files:
        - "{{ galaxy_config_dir }}/total_perspective_vortex/tool_defaults.yml"
        - "https://raw.githubusercontent.com/galaxyproject/tpv-shared-database/main/tools.yml"
        - "{{ galaxy_config_dir }}/total_perspective_vortex/destinations.yml"
        - "{{ galaxy_config_dir }}/total_perspective_vortex/tools.yml"
        - "{{ galaxy_config_dir }}/total_perspective_vortex/interactive_tools.yml"
        - "{{ galaxy_config_dir }}/total_perspective_vortex/conda_in_container.yml"
        - "{{ galaxy_config_dir }}/total_perspective_vortex/users.yml"
        - "{{ galaxy_config_dir }}/total_perspective_vortex/roles.yml"

#
# Job resource selector configuration
#
resources:
  groups:
    usegpu: [gpu]

#
# Job mapping configuration
#
tools:
  - id: keras_train_and_eval
    resources: usegpu
  - id: gmx_sim
    resources: usegpu
  - id: tabpfn
    resources: usegpu

#
# Job limits configuration
#
limits:
  - type: anonymous_user_concurrent_jobs
    value: 3
  - type: destination_user_concurrent_jobs
    value: 2
    id: embedded_pulsar_docker
  - type: output_size
    value: '300GB'
  - type: registered_user_concurrent_jobs
    value: 40
  - type: walltime
    value: '148:00:00'
