#!{{ galaxy_venv_dir }}/bin/python
"""Remove interactive-tool Condor jobs older than 24 hours."""

import os
import re
import sys
from datetime import datetime
from typing import cast

sys.path.insert(0, {{ (galaxy_server_dir ~ "/lib") | to_json }})
import htcondor2  # noqa: E402
import yaml  # noqa: E402
from galaxy.config import GalaxyAppConfiguration  # noqa: E402
from galaxy.job_execution.setup import JobWorkingDirectory  # noqa: E402
from galaxy.model import Job, mapping  # noqa: E402
from galaxy.objectstore import (  # noqa: E402
    BaseObjectStore,
    build_object_store_from_config,
)
from galaxy.util.properties import load_app_properties  # noqa: E402
from sqlalchemy import select  # noqa: E402
from sqlalchemy.orm import Session, scoped_session  # noqa: E402


CONFIG_FILE = {{ galaxy_config_file | to_json }}
PULSAR_APP_CONFIG_FILE = (
    {{ (galaxy_config_dir ~ "/pulsar_app.yml") | to_json }}
)
MAX_AGE = 86400


def connect() -> (
    tuple[GalaxyAppConfiguration, scoped_session[Session], BaseObjectStore]
):
    """Connect to the Galaxy database and object store without a Galaxy app."""
    config = GalaxyAppConfiguration(
        config_file=CONFIG_FILE,
        override_tempdir=False,
        **load_app_properties(config_file=CONFIG_FILE),
    )
    model = mapping.init(
        config.file_path,
        config.database_connection,
        config.database_engine_options,
    )
    object_store = cast(
        BaseObjectStore, build_object_store_from_config(config)
    )
    return config, model.session, object_store


def pulsar_staging_dir(config: GalaxyAppConfiguration) -> str:
    """Staging directory of embedded Pulsar jobs.

    Mirrors the default applied by galaxy.jobs.runners.pulsar when
    pulsar_app.yml does not define staging_directory. Their layout is
    <staging>/<job id>, without the hashed subdirectories.
    """
    if os.path.isfile(PULSAR_APP_CONFIG_FILE):
        with open(PULSAR_APP_CONFIG_FILE) as file:
            staging = (yaml.safe_load(file) or {}).get("staging_directory")
        if isinstance(staging, str) and staging:
            return staging
    return os.path.join(config.data_dir, "pulsar_staging")


def jwd_path(
    job: Job, config: GalaxyAppConfiguration, object_store: BaseObjectStore
) -> str | None:
    """Return the existing JWD path of a job.

    Delegates to JobWorkingDirectory, which resolves the path from
    `job.working_directory` (persisted from the job_working_directory
    destination param, e.g. by TPV) with fallback to the job_work extra_dir
    of the job's object store backend.
    """
    runner = job.job_runner_name or ""
    destination = job.destination_id or ""
    if runner.startswith("pulsar_embedded") or destination.startswith(
        "pulsar_embedded"
    ):
        path: str | None = os.path.join(
            pulsar_staging_dir(config), str(job.id)
        )
    else:
        jwd = JobWorkingDirectory(job, object_store)
        path = jwd.resolve() if jwd.exists() else None
    if path and os.path.isdir(path):
        return path
    if path:
        print(f"Tried JWD candidate {path}, does not exist", file=sys.stderr)
    return None


def condor_cluster_id(jwd: str) -> int | None:
    """Get Condor cluster id of a job from its JWD."""
    external_id = os.path.join(jwd, "external_id")
    try:
        with open(external_id) as file:
            match = re.fullmatch(r'"?(\d+)(?:\.\d+)?"?', file.read().strip())
        return int(match.group(1)) if match else None
    except OSError:
        pass
    log_path = os.path.join(jwd, "job_condor.log")
    try:
        with open(log_path) as file:
            match = re.search(r"\((\d+)\.", file.readline())
        return int(match.group(1)) if match else None
    except OSError:
        return None


def main() -> None:
    """Remove interactive-tool Condor jobs older than 24 hours."""
    if not os.path.isfile(CONFIG_FILE):
        sys.exit(f"Galaxy config file {CONFIG_FILE} does not exist")

    config, session, object_store = connect()
    jobs = session.scalars(
        select(Job).where(
            Job.state == Job.states.RUNNING,
            Job.tool_id.contains("interactive_tool"),
        )
    ).all()
    cluster_jobs: dict[int, list[int]] = {}
    for job in jobs:
        jwd = jwd_path(job, config, object_store)
        if not jwd:
            print(
                f"Failed to resolve JWD (Galaxy job id: {job.id}) on "
                f"{datetime.now():%d-%m-%y %H:%M:%S}"
            )
            continue
        cluster_id = condor_cluster_id(jwd)
        if cluster_id is not None:
            cluster_jobs.setdefault(cluster_id, []).append(job.id)
    session.close()

    if not cluster_jobs:
        return

    constraint = " || ".join(
        f"(ClusterId == {cluster_id} && "
        f"(JobStartDate =?= undefined || time() - JobStartDate >= {MAX_AGE}))"
        for cluster_id in cluster_jobs
    )
    schedd = htcondor2.Schedd()
    for ad in schedd.query(constraint, projection=["ClusterId"]):
        cluster_id = int(ad["ClusterId"])
        schedd.act(
            htcondor2.JobAction.Remove,
            cluster_id,
            reason="Interactive tool job exceeded 24 hours runtime",
        )
        for job_id in cluster_jobs[cluster_id]:
            print(
                f"Removing condor job {cluster_id} (Galaxy job id: "
                f"{job_id}) on {datetime.now():%d-%m-%y %H:%M:%S}"
            )


if __name__ == "__main__":
    main()
