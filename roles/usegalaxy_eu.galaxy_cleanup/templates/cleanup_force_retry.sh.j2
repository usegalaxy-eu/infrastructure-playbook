#!/usr/bin/env bash
##
## This file is maintained by Ansible - CHANGES WILL BE OVERWRITTEN
##
set -uo pipefail

timestamp="$(date --iso-8601=seconds)"
started_at="$(date +%s)"
stdout_log="{{ galaxy_cleanup_log_dir }}/cleanup-${timestamp}-purge_datasets-force-retry.log"
stderr_log="{{ galaxy_cleanup_log_dir }}/cleanup-${timestamp}-purge_datasets-force-retry.err"
ntfy_url="{{ galaxy_cleanup_force_retry_ntfy_url }}"

notify() {
    if [[ -n "${ntfy_url}" ]]; then
        curl --fail --silent --show-error --max-time 30 \
            --data-binary "$1" "${ntfy_url}" >/dev/null || true
    fi
}

notify "The annual Galaxy pgcleanup as started on $(hostname). Happy Holidays!"

"{{ galaxy_venv_dir }}/bin/python" \
    "{{ galaxy_server_dir }}/scripts/cleanup_datasets/pgcleanup.py" \
    -c "{{ galaxy_config_file }}" \
    -o 60 \
    -b 5000 \
    -w 128MB \
    --force-retry \
    -U \
    -l "{{ galaxy_cleanup_log_dir }}" \
    purge_datasets \
    >"${stdout_log}" 2>"${stderr_log}"
exit_code=$?

duration="$(( $(date +%s) - started_at ))"
if [[ ${exit_code} -eq 0 ]]; then
    result="succeeded"
else
    result="failed"
fi

notify "Galaxy annual cleanup ${result} on $(hostname) after ${duration}s (exit ${exit_code}). Logs: ${stdout_log}, ${stderr_log}"
exit "${exit_code}"
