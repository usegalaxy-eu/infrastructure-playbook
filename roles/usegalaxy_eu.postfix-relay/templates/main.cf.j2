myhostname = {{ postfix_myhostname }}
myorigin = {{ postfix_myorigin }}
mydestination = $myhostname, localhost.$mydomain, localhost
inet_interfaces = all
inet_protocols = ipv4
mynetworks = {{ (postfix_mynetworks + postfix_trusted_client_addresses) | unique | join(', ') }}
smtpd_banner = $myhostname ESMTP

compatibility_level = 3.6
smtpd_relay_restrictions = permit_mynetworks, defer_unauth_destination
alias_maps = {{ postfix_database_type }}:/etc/aliases
alias_database = {{ postfix_database_type }}:/etc/aliases

smtpd_tls_security_level = {{ postfix_smtpd_tls_security_level }}

relayhost = [{{ postfix_relay_host }}]:{{ postfix_relay_port }}
sender_dependent_default_transport_maps = {{ postfix_database_type }}:/etc/postfix/sender_transport
empty_address_default_transport_maps_lookup_key = <>
{% if postfix_bulk_subject_regex %}
smtpd_header_checks = {{ postfix_header_checks_type }}:/etc/postfix/header_checks
{% endif %}
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = {{ postfix_database_type }}:/etc/postfix/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_tls_security_level = encrypt
smtp_tls_CAfile = {{ postfix_smtp_tls_cafile }}
smtp_tls_loglevel = 1
{% if postfix_relay_wrappermode %}
smtp_tls_wrappermode = yes
{% endif %}

smtp_destination_rate_delay = {{ postfix_destination_rate_delay }}
smtp_destination_concurrency_limit = {{ postfix_destination_concurrency_limit }}
smtp_destination_concurrency_failed_cohort_limit = 10
bulk_destination_rate_delay = {{ postfix_bulk_destination_rate_delay }}
bulk_destination_concurrency_limit = {{ postfix_bulk_destination_concurrency_limit }}
bulk_destination_concurrency_failed_cohort_limit = 10
dsnrelay_destination_rate_delay = 0s
dsnrelay_destination_concurrency_limit = {{ postfix_destination_concurrency_limit }}
default_destination_concurrency_limit = {{ postfix_destination_concurrency_limit }}

maximal_queue_lifetime = {{ postfix_maximal_queue_lifetime }}
bounce_queue_lifetime = {{ postfix_bounce_queue_lifetime }}
