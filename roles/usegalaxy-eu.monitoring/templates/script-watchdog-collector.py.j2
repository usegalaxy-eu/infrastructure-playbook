#!/usr/bin/env python3
"""Emit CPU tick counters for processes owned by systemd services.

Managed by Ansible. Local changes will be overwritten.
"""

import subprocess
import sys
from pathlib import Path

CGROUP_ROOT = Path("/sys/fs/cgroup")


def escape_tag(value):
    """Escape an InfluxDB line protocol tag value."""
    return (
        str(value)
        .replace("\\", "\\\\")
        .replace(",", "\\,")
        .replace("=", "\\=")
        .replace(" ", "\\ ")
    )


def service_properties(service):
    """Query systemd for the lifecycle and cgroup ownership of a service."""
    command = [
        "systemctl",
        "show",
        service,
        "--property=LoadState,ActiveState,SubState,ControlGroup",
    ]
    result = subprocess.run(
        command, check=False, capture_output=True, text=True, timeout=3
    )
    if result.returncode != 0:
        return None
    return dict(
        line.split("=", 1)
        for line in result.stdout.splitlines()
        if "=" in line
    )


def cgroup_pids(control_group):
    """Return the PIDs of all processes belonging to a cgroup."""
    if not control_group or control_group == "/":
        return []
    path = CGROUP_ROOT / control_group.lstrip("/") / "cgroup.procs"
    try:
        return [int(pid) for pid in path.read_text().splitlines()]
    except (FileNotFoundError, OSError, ValueError):
        return []


def process_ticks(pid):
    """Return (utime, stime) clock ticks from /proc, or None if it is gone."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except (FileNotFoundError, OSError):
        return None
    # utime and stime are fields 14 and 15, after the parenthesized name.
    fields = stat[stat.rfind(")") + 2 :].split()
    return int(fields[11]), int(fields[12])


def emit(service):
    """Emit one InfluxDB line protocol point for a systemd service."""
    properties = service_properties(service)
    if properties is None:
        print(
            f"systemd_watchdog,service={escape_tag(service)},"
            "active_state=unknown,sub_state=unknown "
            "monitor_healthy=0i,running=0i,processes=0i"
        )
        return

    load_state = properties.get("LoadState", "unknown")
    monitor_healthy = load_state == "loaded"
    active_state = properties.get("ActiveState", "unknown")
    sub_state = properties.get("SubState", "unknown")
    pids = cgroup_pids(properties.get("ControlGroup", ""))
    # Ticks only increase while a process is scheduled, so a flat sum means
    # the service is making no progress, however it blocks.
    ticks = [process_ticks(pid) for pid in pids]
    field_values = [
        f"monitor_healthy={int(monitor_healthy)}i",
        f"running={int(active_state == 'active')}i",
        f"processes={len(pids)}i",
    ]
    if None not in ticks:
        # A process vanished mid-scrape; a partial sum would look like a
        # frozen counter, so omit the fields this round.
        field_values.append(f"utime_ticks={sum(t[0] for t in ticks)}i")
        field_values.append(f"stime_ticks={sum(t[1] for t in ticks)}i")
    tags = (
        f"service={escape_tag(service)},"
        f"active_state={escape_tag(active_state)},"
        f"sub_state={escape_tag(sub_state)}"
    )
    print(f"systemd_watchdog,{tags} {','.join(field_values)}")


def main():
    """Emit metrics for every service given on the command line."""
    if len(sys.argv) < 2:
        print("At least one systemd service is required", file=sys.stderr)
        return 2
    for service in sys.argv[1:]:
        emit(service)
    return 0


if __name__ == "__main__":
    sys.exit(main())
